<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Appenders>
        <Console name="Consola" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{HH:mm:ss} %-5level %c{1} - %msg%n"/>
        </Console>
    </Appenders>

    <Loggers>
        <Logger name="es.camisetas.connections.Transacciones"
                level="OFF"/>

        <Root level="WARN">
            <AppenderRef ref="Consola"/>
        </Root>
    </Loggers>
</Configuration>